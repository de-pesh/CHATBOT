# ============================================================================
#  THE ONLY CONFIG FILE - change things here and nowhere else.
#
#  GENERATED by scripts/gen_env_sample.py from the Settings classes: every setting either
#  service reads is listed with its default. Edit your own `.env` (copy of this file), not this.
#
#  Start:   cp .env.sample .env      (Windows: copy .env.sample .env)
#           then fill in the CHANGE_ME values.  `.env` is gitignored.
#  Docker:  docker compose up -d     (after any later edit, run it again: 'restart' does
#           NOT re-read this file). Sections 1-8 reach both containers; section 9 is read by
#           compose itself (ports, images, build arguments).
#  Native:  .\run-local.ps1  or  python local.py install / check / run  (any OS).
#  OpenShift does not read this file: openshift/01-secrets.yaml + 02-configmap.yaml take the
#           same variable names (docs/openshift-release.md).
#
#  A line starting with '#' is a setting left at its built-in default (or unset).
#  Uncommented lines are active: the value shown is the default unless noted.
#
#    1. CHAT MODEL
#    2. FILE STORAGE
#    3. API, LOGIN & LOGGING
#    4. DATABASE, QUEUE & UPLOAD WORKER
#    5. VECTOR STORE, SEARCH & THE COMPUTE SERVICE
#    6. EMBEDDINGS
#    7. PARSING, CHUNKING & OCR
#    8. CHAT PIPELINE: REWRITE, RERANK, CATALOG, LANGUAGE
#    9. DOCKER & BUILD (ports, images, registries)
# ============================================================================


# ============================================================================
#  1. CHAT MODEL - Which AI answers the questions, and how it is called.

# Which chat model answers. Fill in ONLY the matching block below; the rest are ignored. Chat model
# backend. One module per value in app/services/ behind chat_llm_factory.py. One of: litellm | azure |
# ollama | aws | google.
LLM_TYPE=azure

AZURE_OPENAI_API_KEY=CHANGE_ME
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# LiteLLM proxy base URL, e.g. http://litellm:4000
LITELLM_BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1

LITELLM_API_KEY=CHANGE_ME
LITELLM_MODEL_NAME=Kimi-K2.6

# Ollama-style chat completion endpoint URL
# LLM_API_URL=

# Ollama-style chat model name
# MODEL_NAME=

# AWS region of the Bedrock endpoint, e.g. us-east-1
# AWS_REGION=

# Bedrock model or inference-profile ID, e.g. anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_BEDROCK_MODEL_ID=

# AWS access key ID; unset = default credential chain
# AWS_ACCESS_KEY_ID=

# AWS_SECRET_ACCESS_KEY=

# AWS session token, for temporary credentials
# AWS_SESSION_TOKEN=

# Google AI Studio / Gemini API key
# GOOGLE_API_KEY=

# Gemini model name, e.g. gemini-2.5-flash
# GOOGLE_MODEL_NAME=

# Kimi K2.x may accept only one fixed temperature; if chat errors mention 'temperature', set it to 1.
TEMPERATURE=0.1

# GPT-5-mini (a reasoning model): minimal. Kimi and most others: leave BLANK, they reject the
# parameter. OPTIONAL. 'minimal' | 'low' | 'medium' | 'high'. Sent only on the rewrite, rerank and
# translate calls, never on the answer. Only for reasoning models (gpt-5, o-series) used as a helper:
# they otherwise spend seconds 'thinking' per call. Leave unset for any other model: they reject the
# parameter.
LLM_AUX_REASONING_EFFORT=minimal

# Same rule as LLM_AUX_REASONING_EFFORT. OPTIONAL. 'minimal' | 'low' | 'medium' | 'high'. Sent on the
# answer itself. A reasoning model (gpt-5, o-series) otherwise 'thinks' for many seconds before the
# first word; 'minimal' answers from the retrieved passages almost at once. Leave unset for any other
# model: they reject the parameter.
LLM_ANSWER_REASONING_EFFORT=minimal

# Model for the rewrite, rerank and translate calls. Unset = the main model.
LLM_HELPER_MODEL=

# Overrides LLM_HELPER_MODEL for the query rewrite/expansion. 'main' = the main model.
# LLM_REWRITE_MODEL=

# Overrides LLM_HELPER_MODEL for the rerank. 'main' = the main model.
# LLM_RERANK_MODEL=

# Overrides LLM_HELPER_MODEL for the translation. 'main' = the main model.
# LLM_TRANSLATE_MODEL=

# Overrides LLM_HELPER_MODEL for the intent step. 'main' = the main model.
# LLM_INTENT_MODEL=

# Overrides LLM_HELPER_MODEL for writing catalog descriptions. 'main' = the main model.
# LLM_DESCRIBE_MODEL=

# Max simultaneous connections on the shared HTTP client behind every model call (see
# LLM_WARM_CONNECTIONS). Passed straight to httpx.Limits.
LLM_HTTP_MAX_CONNECTIONS=100

# Max idle connections the shared HTTP client keeps open rather than closing after a request. Passed
# straight to httpx.Limits.
LLM_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# How long an idle connection on the shared HTTP client is kept before it is closed. Passed straight
# to httpx.Limits.
LLM_HTTP_KEEPALIVE_EXPIRY_SECONDS=300.0

# Overall timeout for a model call on the shared HTTP client. Generous on purpose: a long answer, or a
# slow backend under load, must not be cut off mid-generation. Passed straight to httpx.Timeout.
LLM_HTTP_TIMEOUT_SECONDS=600.0

# How long the shared HTTP client waits to establish the TCP/TLS connection itself, separate from
# LLM_HTTP_TIMEOUT_SECONDS - a slow or unreachable endpoint should fail fast rather than wait out the
# full call timeout.
LLM_HTTP_CONNECT_TIMEOUT_SECONDS=10.0

# How many connections to the model endpoint are kept open between chat turns, through one HTTP client
# shared by every model. Without this every model call after a few idle seconds opens a new connection
# (a TCP and TLS handshake, about 1 s at 400 ms round trip), twice on the way to the first word. It
# has no effect on what is asked or answered. 0 = leave the SDK's own client alone. Not used with
# Ollama.
LLM_WARM_CONNECTIONS=3

# How often the warm connections to the model endpoint are touched while nobody is chatting (see
# LLM_WARM_CONNECTIONS), so the server on the other end does not close them for being idle.
LLM_WARM_PING_INTERVAL_SECONDS=20.0

# ============================================================================
#  2. FILE STORAGE - Where uploaded documents (and their extracted text) are kept.

# Must be the same value for both services (they share the file store). One of: azure | nextcloud |
# local.
STORAGE_TYPE=local

# Native run: an ABSOLUTE folder (created if missing). Docker and OpenShift mount their own at
# /data/files. Directory the file store lives in; a mounted PVC on OpenShift
LOCAL_STORAGE_PATH=CHANGE_ME_ABSOLUTE_PATH

# Optional base URL serving LOCAL_STORAGE_PATH over HTTP. Without it citations cannot be linkified and
# stay as plain text.
# LOCAL_STORAGE_PUBLIC_URL=

LOCAL_STORAGE_DIR_MODE=770

# Azure Blob Storage account URL (e.g. https://<account>.blob.core.windows.net)
# AZURE_STORAGE_ACCOUNT_URL=

# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_SAS_EXPIRY_MINUTES=30
# BLOB_CONNECTION_STRING=
# BLOB_CONTAINER_NAME=
# NEXTCLOUD_URL=
# NEXTCLOUD_USERNAME=
# NEXTCLOUD_PASSWORD=

# ============================================================================
#  3. API, LOGIN & LOGGING - The HTTP service: auth, CORS, upload limits, paging, log levels.

# True = no login: fine for local use, never for anything shared. The host app handles auth. When
# true, bypasses JWT validation and permission checks on all endpoints, and every caller is folded
# into one dev@local.dev identity - so every chatbot_session/chatbot_history row belongs to that same
# identity too, not to whoever is actually asking. Intentional when this service sits behind a host
# app (e.g. consumed via Module Federation) that already authenticates the user and controls who can
# reach this route at all - this service is then not the access-control boundary. The real auth this
# falls back to when False (dbo.users - see scripts/mssql/02_users.sql) has no self-registration
# endpoint, so create a first account with scripts/create_superuser.py before setting this False, or
# nothing can log in.
DISABLE_AUTH=True

SECRET_KEY=chatbot-local-dev-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins always allowed to call this API: the local-dev UIs (docker-compose
# UI, vite dev server). Exact origins, no trailing slash. Clear it in a deployment that should allow
# only CORS_ALLOWED_ORIGINS.
CORS_LOCAL_ORIGINS=http://localhost:3000,http://localhost:3006,http://127.0.0.1:3006,http://localhost:5173

# Comma-separated extra CORS origins, in addition to CORS_LOCAL_ORIGINS
# CORS_ALLOWED_ORIGINS=

# Responses smaller than this are sent uncompressed - GZipMiddleware's own default threshold, made
# overridable. Compressing a small response wastes more CPU than it saves in bytes on the wire.
GZIP_MIN_SIZE_BYTES=102400

# Comma-separated extensions (with the leading dot) POST /files accepts. The parser in the compute
# service rejects anything it cannot handle anyway; checking here avoids uploading a blob and queuing
# a kb_worker job for a file that was never going to work.
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.doc,.txt,.xlsx,.png,.jpeg,.jpg,.webp,.pptx,.ppt,.html,.htm,.eml,.msg

# Largest single file POST /files accepts, in MB; a larger one is a 413. Each file is read fully into
# memory (UploadFile.read()), so this also bounds memory per upload. 50 MB is a generous default for
# policy documents and scanned PDFs; raise it if a deployment genuinely uploads larger files.
MAX_UPLOAD_SIZE_MB=50

# Records per page in GET /chat/history and GET /chat/session when the caller gives no page_size.
CHAT_PAGE_SIZE_DEFAULT=10

# Largest page_size GET /chat/history and GET /chat/session accept; a larger one is a 422.
CHAT_PAGE_SIZE_MAX=100

# Log level of this service's own code (the `app` logger, everything the service logs itself). DEBUG |
# INFO | WARNING | ERROR | CRITICAL, case-insensitive. Raise it to WARNING to quiet the per-turn INFO
# lines; lower it to DEBUG when tracing a problem. Does not touch uvicorn's own loggers.
LOG_LEVEL=INFO

# Log level of everything that is not this service's own code: the root logger and the noisy third-
# party loggers (azure, pymongo.client). DEBUG | INFO | WARNING | ERROR | CRITICAL, case-insensitive.
# Lower it only to diagnose a library; at INFO or below the Azure SDK logs every HTTP request.
LOG_LEVEL_LIBRARIES=WARNING

# ============================================================================
#  4. DATABASE, QUEUE & UPLOAD WORKER - SQL Server, Redis and the background worker that ingests
#  uploads.

# One of: mssql.
DB_TYPE=mssql

DB_CONNECTION_STRING=Server=localhost,1433;UserID=sa;Password=CHANGE_ME;Database=chatbot

# Path to a CA bundle (PEM) inside the container. With Encrypt=yes in DB_CONNECTION_STRING the SQL
# Server's certificate is checked against it. Without it, Encrypt=yes needs TrustServerCertificate=yes
# (encrypted, certificate not checked). The host name in the certificate is never compared.
# DB_TLS_CA_FILE=

# How long an MSSQL connection attempt is allowed before giving up. mssql only - used both by the
# service's own connection pool (mssql_service.py) and by services/db/schema_migrator.py's startup
# schema check. scripts/apply_schema.py runs outside this Settings class entirely and keeps its own
# copy of the same default.
DB_LOGIN_TIMEOUT_SECONDS=10

# At startup, create the database if it is missing and apply any pending scripts/mssql/*.sql. Turn off
# when a DBA owns the schema.
AUTO_APPLY_SCHEMA=true

# Connections opened at startup and shared by every request. Each stored-procedure call holds one for
# its duration, so this is the number of database calls that can run at once; a call beyond it waits
# for a free connection. Raise it if requests queue on the database.
MSSQL_POOL_SIZE=5

# How long a starting instance waits for another instance to finish applying the schema (the migration
# lock) before it gives up and stops. Applies to the startup schema step only (AUTO_APPLY_SCHEMA);
# scripts/apply_schema.py keeps its own copy of the same default.
SCHEMA_LOCK_TIMEOUT_SECONDS=120

# One of: redis | celery.
QUEUE_TYPE=celery

REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# How much longer than one blocking pop (WORKER_BRPOP_TIMEOUT) a Redis socket may sit idle before it
# is treated as dead: the socket timeout is WORKER_BRPOP_TIMEOUT plus this. Too small and a healthy
# idle pop times out as a Redis error; too large and a black-holed connection takes that much longer
# to notice.
REDIS_SOCKET_TIMEOUT_MARGIN_SECONDS=10

# How often an idle Redis connection is PINGed to notice that it has died, before the next command is
# sent on it. Shorter finds a dead connection sooner at the cost of one extra round trip per interval
# per idle connection.
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# Sharing a Redis with a teammate? Give each of you a different name or you will take each other's
# upload jobs.
CHATBOT_QUEUE_NAME=chatbot_queue

CHATBOT_QUEUE_DLQ_NAME=chatbot_queue_dlq
CHATBOT_QUEUE_MAX_RETRIES=3

# Run the chatbot_queue consumer in-process. Ignored with QUEUE_TYPE=celery, where the API never
# consumes.
KB_WORKER_ENABLED=true

WORKER_BRPOP_TIMEOUT=5
WORKER_ERROR_RETRY_DELAY=30

# How long a worker may hold a task before the queue treats it as lost. A task taken off the queue is
# leased for this long; if the worker dies (OOMKill, rollout, node loss) the lease runs out and any
# replica's worker puts the task back on the queue, counting one retry (CHATBOT_QUEUE_MAX_RETRIES) and
# dead-lettering it when they are spent. Leases are not renewed, so this must comfortably exceed the
# longest legitimate parse + index of one file (two RPC_TIMEOUT_SECONDS calls plus the DB writes and
# catalog refresh): too short and a healthy but slow worker has its task taken and run a second time;
# too long and a lost task waits that long before it is recovered.
WORKER_LEASE_SECONDS=900

# How often each worker looks for expired task leases (see WORKER_LEASE_SECONDS), and once when it
# starts. The check is one small sorted-set read, so a shorter interval only shortens how long a lost
# task sits after its lease runs out; it never speeds up the lease itself.
WORKER_REAP_INTERVAL_SECONDS=60

# How much of a permanently-failed kb_worker task's error message is stored on the file record
# (processing_error). The full message is still logged; this only bounds what is written to the
# database column.
WORKER_ERROR_MESSAGE_MAX_CHARS=1000

# ============================================================================
#  5. VECTOR STORE, SEARCH & THE COMPUTE SERVICE - MongoDB and hybrid search (main-service runs Search
#  in-process - see its own copy of these settings), and the REST link to the compute service for
#  document ingestion.

# MongoDB connection string
MONGO_CONNECTION_STRING=mongodb://localhost:27017

# MongoDB database name
# MONGO_DATABASE_NAME=

# MUST equal VECTOR_COLLECTION_NAME (the compute service's setting) - nothing checks it at startup.
MONGODB_COLLECTION_NAME=chatbot_policies

# Collection holding chunks for DISABLE/INACTIVE files - excluded from search
MONGODB_DISABLED_COLLECTION_NAME=chatbot_policies_disabled

# How long the Mongo driver waits for a server to respond before giving up on a connection attempt.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Vector database backend One of: mongo.
VECTOR_STORE=mongo

# False (default): Atlas $vectorSearch runs ANN (approximate, HNSW-graph search) - scales better on
# large collections but can occasionally miss a true nearest neighbour. True: it runs ENN (exact,
# exhaustive search). Has no effect on plain community MongoDB, which always falls back to an exact
# brute-force search anyway.
VECTOR_SEARCH_EXACT=false

# ANN (approximate) vector search asks Atlas to consider this many times `limit` candidates before its
# HNSW graph settles on the closest `limit` - over-fetching so a true nearest neighbour is not missed
# at the margin. Not used with VECTOR_SEARCH_EXACT True.
VECTOR_OVERFETCH_MULTIPLIER=10

# The Atlas $vectorSearch index name on each collection.
VECTOR_INDEX_NAME=vector_index

# MUST equal MONGODB_COLLECTION_NAME.
VECTOR_COLLECTION_NAME=chatbot_policies

# The $text index name on each collection.
TEXT_INDEX_NAME=text_search_index

# Lexical half of hybrid search: bm25 (in-process, stemmed) | text (MongoDB $text index). One of: bm25
# | text.
LEXICAL_SEARCH=bm25

# Hybrid search fuses a vector-ranked list and a lexical-ranked list, each fetched deeper than the
# caller's own `limit` (depth = max(limit * this, HYBRID_FUSION_DEPTH_MIN)) - a chunk that ranks 15th
# by meaning and 2nd by keywords only makes it into the fused top 10 if both source lists were long
# enough to contain it.
HYBRID_FUSION_DEPTH_MULTIPLIER=4

# Floor on the fusion depth above; see HYBRID_FUSION_DEPTH_MULTIPLIER.
HYBRID_FUSION_DEPTH_MIN=40

# Reciprocal Rank Fusion weight of the lexical list relative to the vector list (which counts as 1.0).
# Chosen on a labelled set of 180 queries against this knowledge base.
HYBRID_LEXICAL_WEIGHT=0.5

# Reciprocal Rank Fusion's rank-damping constant: a chunk scores weight/(k + rank) in each list it
# appears in.
HYBRID_RRF_K=10

# Okapi BM25 term-frequency saturation for the in-process lexical index.
BM25_K1=1.5

# Okapi BM25 length-normalisation strength for the in-process lexical index.
BM25_B=0.75

# How many hits a Search asks the vector store for.
SEARCH_RESULT_LIMIT=10

# After this many seconds with no Search, one is run in the background to keep the embedding model and
# the database warm. The first question after a quiet spell measurably paid extra for a cold search; a
# real search resets the clock, so this costs at most one search per interval and nothing while the
# chatbot is in use. 0 turns it off.
SEARCH_WARMUP_SECONDS=45

# Deadline on every call to the compute service (ParseFile, Index, Delete). Without one a hung
# compute-plane pod blocks the caller forever - a kb_worker task that never times out into a retry.
# One deadline for all three; ParseFile in particular can run OCR over a large scanned PDF and may
# need more room than this if that turns out to be too tight in practice.
RPC_TIMEOUT_SECONDS=120

# Base URL of the compute service
INDEXING_SERVICE_URL=http://127.0.0.1:8001

PORT=8001
HOST=0.0.0.0

# Chunks indexed before 'embeddingModel' was recorded carry no model name; this is the model they are
# assumed to have been made with, for the stale-index check at startup.
LEGACY_EMBEDDING_MODEL_ID=gte-multilingual-base

# ============================================================================
#  6. EMBEDDINGS - Turning text into vectors.

# litellm | azure | remote | local. main-service's Search does not support local (no torch there) -
# only the compute service's own indexing-time embedding does; build the image with
# EMBEDDING_MODE=remote (section 9) for anything but local. Query-time embedding backend One of:
# litellm | azure | remote.
EMBEDDING_TYPE=remote

# Embeddings endpoint base URL (litellm/azure/remote)
# EMBEDDING_BASE_URL=

# Embedding model name / deployment name
# EMBEDDING_MODEL_NAME=

# Embeddings endpoint API key
# EMBEDDING_API_KEY=

# Only for EMBEDDING_TYPE=azure
EMBEDDING_API_VERSION=2024-10-21

# Must equal the vector length the embedding model returns; the compute service refuses to start
# otherwise. The vector store's index is created with this many dimensions - must match whatever the
# configured embedding model actually outputs, or every write and query against the vector index
# fails. Not auto-detected: changing the embedding model requires setting this and reindexing,
# deliberately, rather than silently producing a dimension mismatch.
EMBEDDING_DIMENSION=768

# Texts per embeddings request. Endpoints cap the inputs per call.
EMBEDDING_BATCH_SIZE=64

# Send EMBEDDING_DIMENSION as the request's `dimensions` field, for a model that can shorten its
# output.
EMBEDDING_SEND_DIMENSIONS=false

# How long to wait for one embeddings HTTP call before giving up.
EMBEDDING_TIMEOUT=60.0

# How many times to retry a rate limit or a transient server/network error.
EMBEDDING_MAX_RETRIES=3

# Retry n waits this ** (n - 1) seconds (1s, 2s, 4s at 2.0); a larger base backs off harder under a
# rate limit.
EMBEDDING_RETRY_BACKOFF_BASE=2.0

# Comma-separated HTTP statuses that are retried; any other status fails the call at once.
EMBEDDING_RETRY_STATUS_CODES=429,500,502,503,504

# EMBEDDING_MODEL_PATH=
# EMBEDDING_DEVICE=
EMBEDDING_TRUST_REMOTE_CODE=true
REINDEX_BATCH_SIZE=32

# ============================================================================
#  7. PARSING, CHUNKING & OCR - Reading documents and splitting them for indexing.

CHUNK_SIZE=4000
CHUNK_OVERLAP=200
VISION_MAX_IMAGE_SIDE=2048
VISION_PAGE_RENDER_DPI=200

# One of: litellm | azure | foundry | ollama | openai | none.
VISION_LLM_TYPE=none

# VISION_OPENAI_BASE_URL=
# VISION_OPENAI_API_KEY=
# VISION_OPENAI_MODEL=
VISION_TEMPERATURE=0.1
VISION_NUM_CTX=8192
IMAGE_JPEG_QUALITY=92
# AZURE_AI_FOUNDRY_ENDPOINT=
# AZURE_AI_FOUNDRY_API_KEY=
# AZURE_AI_FOUNDRY_MODEL=
AZURE_AI_FOUNDRY_API_VERSION=2024-05-01-preview
# OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2-vision:11b

# ============================================================================
#  8. CHAT PIPELINE: REWRITE, RERANK, CATALOG, LANGUAGE - How a question becomes an answer, and what it
#  knows about who is asking.

# Decide before searching whether a message needs the knowledge base at all, so a greeting or 'what do
# you have?' is answered in a couple of seconds instead of running the whole pipeline. Only a message
# that is nothing but small talk, or a request to list the knowledge base, is diverted; every question
# still goes to the full pipeline. Turn off to always run it.
INTENT_ROUTING_ENABLED=true

# How many recent chat messages the intent-routing step (chitchat/kb_overview/knowledge
# classification) is shown. A separate window from REWRITE_HISTORY_TURNS - same idea, tuned
# independently since the intent step needs much less context to decide whether a message needs the
# knowledge base at all.
INTENT_HISTORY_TURNS=4

# How much of each of those INTENT_HISTORY_TURNS messages is kept, characters per message.
INTENT_HISTORY_CHARS=400

# Only a message this short or shorter is even offered to the intent-routing step. A longer message is
# a question with a greeting in front of it, or a request in its own right, and goes straight to the
# full pipeline - one less call, and one less way to divert something that deserved an answer.
INTENT_MAX_WORDS=12

# The hard ceiling on how many searches one chat turn can fan out into, however many questions the
# rewrite step returns. Exists to stop a confused model that splits a sentence into fifty 'questions'
# from firing fifty searches; a question the user actually asked is never dropped below this ceiling.
REWRITE_MAX_QUERIES=8

# What the rewrite step aims to fan a query out into: splits plus expansion variants combined. A
# budget, not a guillotine - REWRITE_MAX_QUERIES is the only hard limit, and alternates are spent
# before an original question is ever dropped.
REWRITE_EXPANSION_BUDGET=4

# How many recent chat messages the query-rewrite step is shown. It needs history for one thing -
# resolving 'it', 'this', 'the previous requirement' - which is always the last turn or two; bounded
# so the rewrite prompt cannot grow with the conversation.
REWRITE_HISTORY_TURNS=6

# How much of each of those REWRITE_HISTORY_TURNS messages is kept, characters per message.
REWRITE_HISTORY_CHARS=600

# Speed-up for the rerank call: the model still reads every passage under its full id but writes back
# only the first 8 characters of each, which is most of what it spends its time on (about 0.5 s of a
# ~1.8 s call, measured on gpt-5.4-mini). The passages it chooses shift slightly in the lower ranks
# compared with full ids (top-3 unchanged; top-8 overlap 0.77 against 0.85 for the full-id prompt with
# itself), so it is off until you have judged it on your own questions.
RERANK_SHORT_IDS=false

# Passages kept after reranking - how much context the final answer prompt is actually built from.
# Retrieval casts wider than this on purpose (see REWRITE_MAX_QUERIES); the rerank call is what
# narrows it back down.
RERANK_TOP_K=8

# Most passages sent to the rerank call, best fused score first. The rerank prompt grows with every
# one, and the tail of a long candidate list is the least likely to make RERANK_TOP_K, so it is not
# worth the model reading it.
RERANK_MAX_CANDIDATES=20

# How much of each candidate passage's text is shown to the rerank call. The rerank prompt only needs
# enough to judge relevance, not the whole passage - the full text still reaches the answering model
# afterwards.
RERANK_PASSAGE_CHARS=600

# With RERANK_SHORT_IDS on, how many characters of a chunk's id the model is asked to write back. An
# id is a 36-character UUID; writing out up to RERANK_TOP_K of those is most of what the rerank call
# spends its time on.
RERANK_ID_CHARS=8

# Rank-damping constant of the Reciprocal Rank Fusion that merges the searches of one question's
# rewritten queries (the question as asked plus its alternate wordings): a chunk scores 1/(k + rank)
# in each search that returned it. Smaller means the top of each search dominates. Starts at the
# store's own HYBRID_RRF_K; it has not been tuned on labelled queries the way that one was. Has no
# effect on a question that is searched only once.
QUERY_FUSION_RRF_K=10

# Whether the bot may tell users what the knowledge base holds: list its documents for 'what do you
# have?', mention them in a greeting, and name them when it refuses an off-topic question. Off, it
# says only that it can answer questions from its documents. Off, the catalog is kept out of every
# prompt (the query rewrite included, so search does not use the document descriptions) and a reply
# that names a document is replaced in code. The catalog is still built.
KB_OVERVIEW_ENABLED=false

# How long a replica keeps the knowledge-base catalog before re-reading it.
KB_CATALOG_CACHE_SECONDS=60.0

# The catalog goes into a prompt on every chat turn; past this many characters it is cut down to names
# only (see KbCatalog.render), so a knowledge base with many documents does not blow out every
# prompt's size.
KB_CATALOG_RENDER_MAX_CHARS=3500

# How much of a document's start is read to write its catalog description. A regulation's first pages
# - its contents page and introduction - say what it is.
KB_CATALOG_DESCRIBE_CHARS=6000

# Longest catalog description kept per document, so one verbose reply from the describe model cannot
# bloat every prompt that reads the catalog.
KB_CATALOG_DESCRIPTION_MAX_CHARS=320

# Longest a document's name gets in the catalog text before it is cut short at a word. Applies to the
# catalog in the prompts and to the names checked against an intent reply, so changing it changes what
# counts as naming a document.
KB_CATALOG_NAME_WIDTH=60

# With the overview off, an intent reply is replaced when it contains a document's name. A name
# shorter than this is ignored by that check, so a two-letter document name does not match inside
# ordinary words.
KB_NAME_MENTION_MIN_CHARS=3

# Path of the catalog file inside the file store (STORAGE_TYPE). Change it only to keep two
# deployments that share one store from sharing a catalog.
KB_CATALOG_KEY=_kb_catalog/catalog.json

# What the user is told when the intent step's reply would name a knowledge-base document while
# KB_OVERVIEW_ENABLED is off: the reply is replaced by this text. It reaches the user as the answer,
# so write it in the language and tone of the bot.
# NO_OVERVIEW_REPLY="I couldn't find relevant information in the knowledge base. Please try rephrasing your question."

# Inline CSS put on every citation link in an answer. The chat UI recognises the link by its shape,
# not its style, so this only changes how the citations look.
CITATION_LINK_STYLE="color:#eed202"

# Longest a document's name gets inside an inline citation label ('[SAMA, Pg: 5]') before it is cut
# short at a word. Narrow on purpose: it sits inside a sentence. The full name is still on the link's
# hover text.
CITATION_LABEL_NAME_WIDTH=18

# How short a translation may be next to the answer it was made from, as a fraction. A real
# translation carries the whole answer over and lands within a fraction of its length in every
# language here; well under half means the model did not translate - it summarised, truncated, or
# wrote back the schema's own placeholder instead of the answer.
TRANSLATION_MIN_RATIO=0.5

# Every language borrows - an Arabic answer still writes 'SAMA' and 'IFRS 9' in Latin letters. The
# script holding at least this share of a text's letters is the one it is considered written in; below
# it, the text is mixed enough not to say.
LANGUAGE_SCRIPT_SHARE=0.6

# A script is only read off text with enough letters to carry one. A query is allowed to be short -
# '?? ?? ?????' is the whole question - so its floor is lower than an answer's (see
# LANGUAGE_ANSWER_MIN_LETTERS).
LANGUAGE_QUERY_MIN_LETTERS=4

# The same floor as LANGUAGE_QUERY_MIN_LETTERS, but for an answer: a one-word reply cannot decide what
# language a whole response is in.
LANGUAGE_ANSWER_MIN_LETTERS=12

# Local hour (0-23) at which 'Good Morning' starts to be used when the bot answers a greeting. The
# four GREETING_*_START_HOUR values must be in ascending order; Night runs from
# GREETING_NIGHT_START_HOUR past midnight until this hour. Only takes effect when the chat request
# carries the user's local hour.
GREETING_MORNING_START_HOUR=5

# Local hour (0-23) at which 'Good Afternoon' starts; see GREETING_MORNING_START_HOUR.
GREETING_AFTERNOON_START_HOUR=12

# Local hour (0-23) at which 'Good Evening' starts; see GREETING_MORNING_START_HOUR.
GREETING_EVENING_START_HOUR=17

# Local hour (0-23) at which 'Good Night' starts; see GREETING_MORNING_START_HOUR.
GREETING_NIGHT_START_HOUR=21

# How many of the user's most recent questions (across all their conversations) are shown to the model
# as part of who is asking, so an answer can lean on what they have been working on. 0, the default,
# shows none and skips the extra database read. They are sent to the model provider like any other
# part of the prompt, which is why it is opt-in.
USER_CONTEXT_RECENT_QUESTIONS=0

# Each recent question is cut to this many characters (USER_CONTEXT_RECENT_QUESTIONS).
USER_CONTEXT_QUESTION_CHARS=200

# ============================================================================
#  OTHER

# A second model, on the same backend, that writes the answer when the main model fails (an error or
# timeout before the first word). Unset = no fallback: the turn fails as before.
# LLM_FALLBACK_MODEL=

# Overrides LLM_HELPER_MODEL for the grounding check. 'main' = the main model.
# LLM_GROUNDING_MODEL=

# Most chat turns (POST /chat and /chat/stream) one user may start per minute; more is a 429. 0 turns
# the limit off. Counted in Redis so it holds across replicas (a fixed one-minute window); if Redis is
# unreachable it is counted in memory per replica instead.
CHAT_RATE_LIMIT_PER_MINUTE=30

# When the search finds nothing (or nothing at or above MIN_RELEVANCE_SCORE), answer with
# NO_EVIDENCE_REPLY straight away instead of asking the model to write an answer from no passages.
# Saves the generation call and rules out an answer made up from nothing; the turn is traced as
# 'no_evidence'.
NO_EVIDENCE_GATE_ENABLED=true

# What the user is told when the evidence gate (NO_EVIDENCE_GATE_ENABLED) stops a turn. Written in
# English; it is translated into the question's language when that is not English.
# NO_EVIDENCE_REPLY="I couldn't find enough information in the knowledge base to answer that. Try rephrasing, or ask about a specific document or topic."

# Hits the store scores below this are dropped before the fusion and rerank, so a turn whose best hit
# is weak reaches the evidence gate. 0 keeps everything. The score is the store's own (hybrid) score,
# not a 0-1 similarity: read `top_score` in GET /admin/chat-trace/{id} for real turns before choosing
# a value.
MIN_RELEVANCE_SCORE=0.0

# Most retrieved passages recorded in one turn's trace (the best-first ones).
TRACE_MAX_HITS=30

# Longest search query kept in a trace; longer ones are cut.
TRACE_QUERY_MAX_CHARS=300

# Store a per-turn trace (queries, retrieved and reranked passages, outcome, model, config version) in
# dbo.chatbot_trace for GET /admin/chat-trace/{history_id}.
TRACE_ENABLED=true

# Audit-log rows older than this are deleted at startup and by POST /admin/purge. 0 keeps them
# forever.
AUDIT_RETENTION_DAYS=365

# Chat-trace rows older than this are deleted at startup and by POST /admin/purge. 0 keeps them
# forever.
TRACE_RETENTION_DAYS=180

# Read each question for which versions of a document it wants: 'compare with the previous version'
# and 'what did version 2 say' reach older versions, everything else is answered from the latest. Off
# = every question uses the latest versions only (older ones stay stored).
VERSION_DETECTION_ENABLED=true

# Searches for a scope narrower than 'every version' ask the store for this many times as many hits,
# then keep the ones in scope: an older version of a passage ranks right beside its replacement and
# would otherwise use up a slot. 1 = no over-fetch.
VERSION_OVERFETCH_MULTIPLIER=2

# Check each answer's citations against the passages they cite, once it has already been sent to the
# browser, and record the verdict on its chatbot_history row (scripts/mssql/07_chatbot_grounding.sql).
# Falls back to a fast local lexical check when the LLM call fails or returns no usable verdict.
GROUNDING_CHECK_ENABLED=false

# How much of each cited passage's text the grounding check is shown (GROUNDING_CHECK_ENABLED). Larger
# than RERANK_PASSAGE_CHARS: judging whether a claim is actually supported needs more of the passage
# than judging relevance does.
GROUNDING_PASSAGE_CHARS=800

# QUEUE_TYPE=celery: how many files one worker pod ingests at once (threads). Raising it is the way to
# ingest faster; the limits are then the compute service and the embedding endpoint, not this pod,
# which mostly waits on them.
CELERY_CONCURRENCY=4

# QUEUE_TYPE=celery: how long past WORKER_LEASE_SECONDS the broker waits before it hands an
# unacknowledged task to another worker. Redis has no per-task ack timeout, only this one: too short
# and a slow ingest is delivered a second time while the first is still running.
CELERY_VISIBILITY_MARGIN_SECONDS=300

# QUEUE_TYPE=celery: the Redis list tasks go on. Unset = CHATBOT_QUEUE_NAME + '_celery'.
# CELERY_QUEUE_NAME=

# QUEUE_TYPE=celery: after a file is ingested the knowledge-base catalog is refreshed once, this many
# seconds later, however many files finish in between - so a bulk upload costs one refresh (one
# description call per new document), not one per file.
CELERY_CATALOG_REFRESH_DELAY_SECONDS=5

# A file in 'pending' or 'processing' for longer than this many seconds is considered stuck and is
# requeued by the startup sweep and the periodic watchdog. Should be well above WORKER_LEASE_SECONDS
# (default 900) so a legitimately slow ingest is not interrupted.
INGEST_RECOVERY_STUCK_SECONDS=1800

# How often (seconds) the background ingest-recovery task checks for stuck files. Set to 0 to disable
# the periodic check (the startup sweep still runs).
INGEST_RECOVERY_INTERVAL_SECONDS=300

# TIKA_URL=
DOCLING_CHUNK_MAX_TOKENS=512
# QDRANT_URL=
# QDRANT_API_KEY=
QDRANT_TIMEOUT=30.0
MAX_BLANK_PAGE_SHARE=0.5

# Base URL of main-service-chatbot (for catalog refresh)
# MAIN_SERVICE_URL=

# ============================================================================
#  9. DOCKER & BUILD - read by docker-compose.yml, not by the services

COMPOSE_PROJECT_NAME=chatbot

# Prefix for container names and the network: <prefix>-redis, <prefix>-main-service, ...
CONTAINER_PREFIX=chatbot

# Host port for main-service (the browser calls it directly).
MAIN_SERVICE_HOST_PORT=8000

# Host port for the compute service's REST server.
INDEXING_HOST_PORT=8001

FRONTEND_HOST_PORT=3006
REDIS_HOST_PORT=6379
MONGO_HOST_PORT=27017
MSSQL_HOST_PORT=1433
REDIS_IMAGE=redis:7-alpine
MONGO_IMAGE=mongo:7
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# Tika image (legacy .doc/.ppt).
TIKA_IMAGE=apache/tika:4.0.0

TIKA_MEM_LIMIT=1g

# Tag given to the built main-service image.
MAIN_SERVICE_IMAGE=chatbot/main-service:local

# Tag given to the built compute image.
INDEXING_IMAGE=chatbot/indexing-rpc-server:local

# Tag given to the built UI image.
FRONTEND_IMAGE=chatbot/frontend:local

# The local SQL Server's sa password: 8+ chars, 3 of upper/lower/digit/symbol, no ';'.
MSSQL_SA_PASSWORD=Chatbot_Local_1

# SQL Server edition.
MSSQL_PID=Developer

# Database the containers use. A native run names its own in DB_CONNECTION_STRING.
MSSQL_DATABASE_NAME=chatbot

# Point the containers at an external Redis instead of the redis container.
# DOCKER_REDIS_URL=

# Point the containers at an external SQL Server.
# DOCKER_DB_CONNECTION_STRING=

# Point the containers at an external MongoDB.
# DOCKER_MONGO_CONNECTION_STRING=

# Point the containers at an external Tika.
# DOCKER_CONVERTER_URL=

# BUILD: registry the Red Hat base images come from (an internal mirror on a closed network).
BASE_REGISTRY=registry.access.redhat.com

# BUILD: internal PyPI mirror, when there is one.
# PIP_INDEX_URL=

# BUILD: host to trust for PIP_INDEX_URL when it is plain http.
# PIP_TRUSTED_HOST=

# BUILD: internal npm registry, when there is one.
# NPM_REGISTRY=

# BUILD: where the compute image gets EPEL (an internal mirror on a closed network).
EPEL_RPM_URL=https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm

# BUILD: local bakes torch and the embedding model into the compute image; remote (default) leaves
# them out. Must match EMBEDDING_TYPE - main-service's Search never supports local anyway.
EMBEDDING_MODE=remote

# BUILD: download fetches the local embedding model at build time; vendored uses vendor/gte-
# multilingual-base.
HF_MODEL_MODE=download

# BUILD: optional skips OCR/LibreOffice packages that are missing from the mirrors instead of failing.
OCR_MODE=optional

# BUILD: system packages for OCR and Office conversion. Add tesseract-langpack-<code> for more OCR
# languages.
OCR_PACKAGES="tesseract tesseract-langpack-eng tesseract-langpack-ara ghostscript qpdf pngquant unpaper libreoffice-headless"

# BUILD: npm script that builds the UI (build:local = standalone, build:qa = with the Module
# Federation remote).
BUILD_SCRIPT=build:local

# BUILD: where the BROWSER reaches main-service, baked into the UI. Blank = http://localhost:8000.
# Rebuild the frontend after changing it.
# VITE_API_BASE_URL=
