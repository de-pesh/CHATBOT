services:
  redis:
    build:
      context: .
      dockerfile: Dockerfile.redis
    container_name: ccpm-redis
    ports:
      - "7000:7000"
    volumes:
      - redis-data:/data
    restart: unless-stopped

  mongo:
    image: mongo:7
    container_name: ccpm-mongo
    ports:
      - "27017:27017"
    volumes:
      - mongo-data:/data/db
    restart: unless-stopped

  mysql:
    image: mysql:8
    container_name: ccpm-mysql
    environment:
      MYSQL_ROOT_PASSWORD: pass
      MYSQL_DATABASE: ccpm
    ports:
      - "3306:3306"
    volumes:
      - mysql-data:/var/lib/mysql
    restart: unless-stopped

volumes:
  redis-data:
  mongo-data:
  mysql-data:
