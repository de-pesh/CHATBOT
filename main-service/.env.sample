# Shape of main-service/.env. The real file holds live credentials and is
# gitignored. docker-compose sets all of this itself, so this matters for a
# native run and as the reference for a deployment's ConfigMap/Secret.

# --- Application ---
DEBUG=False
# When true, bypasses JWT validation and permission checks on all endpoints. Keep false in production.
DISABLE_AUTH=False

# --- Backend selection -------------------------------------------------------
# Each of these picks an implementation; see the matching *_factory.py.
# Only the values listed are implemented.

# mysql. A different backend also needs its own port of scripts/*.sql - the
# data layer is stored procedures. See services/database_factory.py.
DB_TYPE="mysql"
DB_CONNECTION_STRING=""

# redis
QUEUE_TYPE="redis"

# local | azure | nextcloud. Must match indexing-rpc-server's: only paths cross
# the RPC between them, so both must address the same store.
STORAGE_TYPE="azure"

# --- File storage: local (a mounted persistent volume; the OpenShift target) --
LOCAL_STORAGE_PATH="/data/files"
# Optional. A base URL serving LOCAL_STORAGE_PATH over HTTP. Without it,
# citations cannot be turned into links and stay as plain text.
LOCAL_STORAGE_PUBLIC_URL=""

# --- File storage: azure -----------------------------------------------------
AZURE_STORAGE_ACCOUNT_URL=""
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME=""
AZURE_STORAGE_SAS_EXPIRY_MINUTES=30

# --- File storage: nextcloud -------------------------------------------------
NEXTCLOUD_URL=""
NEXTCLOUD_USERNAME=""
NEXTCLOUD_PASSWORD=""

# --- Redis -------------------------------------------------------------------
REDIS_URL=""
REDIS_PASSWORD=""
CHATBOT_QUEUE_NAME="chatbot_queue"
CHATBOT_QUEUE_DLQ_NAME="chatbot_queue_dlq"
CHATBOT_QUEUE_MAX_RETRIES=3

# --- KB queue worker ---------------------------------------------------------
# Set false on API replicas and true on a dedicated worker replica to scale
# ingestion away from the request path. Same image either way.
KB_WORKER_ENABLED=True
WORKER_BRPOP_TIMEOUT=5
WORKER_ERROR_RETRY_DELAY=5

# --- Compute service ---------------------------------------------------------
# host:port of indexing-rpc-server: ParseFile, Index, Search, Update, Delete,
# ListDocuments. This service holds no vector-database client of its own; the
# collection name is all it knows about the store.
RPC_SERVER="indexing-rpc-server:8001"
MONGODB_COLLECTION_NAME="chatbot_policies"

# --- Chat: Azure OpenAI (preferred) ------------------------------------------
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_VERSION="2024-05-01-preview"
AZURE_OPENAI_DEPLOYMENT_NAME=""

# --- Chat: Ollama (fallback, used only when the Azure OpenAI vars are unset) --
LLM_API_URL=""
MODEL_NAME=""
TEMPERATURE=0.1

# --- JWT ---------------------------------------------------------------------
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
