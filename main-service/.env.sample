# --- Application Settings ---
APP_NAME="CCPM Main Service"
ENVIRONMENT="development"
DEBUG=False
LOG_LEVEL="INFO"
# When true, bypasses JWT validation and permission checks on all endpoints. Keep false in production.
DISABLE_AUTH=False


# --- Azure Blob Storage Settings ---
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME=""

# --- Redis Settings ---
REDIS_URL=""
REDIS_PASSWORD=""
SESSION_EXPIRY_TIME=3600
PARSER_QUEUE_NAME=""
LLM_QUEUE_NAME=""
CHATBOT_QUEUE_NAME=""

# --- Database configuration ---
DB_TYPE="oracle"
DB_CONNECTION_STRING=""

# --- File Upload Settings ---
ALLOWED_FILE_TYPES='["pdf", "docx"]'

# --- JWT Settings ---
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30