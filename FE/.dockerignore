# Host-installed dependencies: these are Windows/darwin binaries (esbuild,
# rollup, sharp). "COPY . ." runs AFTER "npm install" in the build stage, so
# without this line the host's node_modules overwrite the Linux ones the image
# just installed and "vite build" dies on a missing platform binary.
node_modules
dist
.vite

# Local env / VCS / deploy manifests
.env
.env.*
.git
.gitignore
k8s/
*-pipeline.yml
*-pipeline.yaml
Dockerfile
.dockerignore

# Editor + OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store

# Docs
README.md
