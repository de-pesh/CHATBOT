# --- Secrets -----------------------------------------------------------------
# Every .env here holds live Azure Blob and Azure OpenAI credentials. The
# .env.sample is committed instead and shows the shape.
# docker-compose.yml is safe: it only references ${VARS} from the root .env.
.env
*/.env
.env.local
*/.env.local
.env.uat

# openshift/01-secrets.yaml is filled in with real credentials before
# `oc apply` (see its own header comment) - never commit the filled-in
# version. openshift/ref.yaml is a real secrets file copied in from another
# project for reference and must never be committed either.
openshift/01-secrets.yaml
openshift/ref.yaml

# --- Dependencies and build output -------------------------------------------
node_modules/
*/node_modules/
.venv/
*/.venv/
venv/
dist/
*/dist/
.vite/

# --- Model weights -----------------------------------------------------------
# indexing-rpc-server clones gte-multilingual-base (~600 MB) at image build
# time; it should never be in the repo.
hf_models/
*/hf_models/
vendor/gte-multilingual-base/

# --- Python noise ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editor / OS -------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local scratch -----------------------------------------------------------
dead_modules.txt
*.log

# Module Federation build temp (regenerated by the vite plugin)
.__mf__temp/
