# Shape of indexing-rpc-server/.env. The real file holds live credentials and
# is gitignored; docker-compose sets all of this itself.

# --- File storage ------------------------------------------------------------
# local | azure. MUST match main-service's STORAGE_TYPE: only paths cross the
# RPC between the two, so both have to address the same store. Under 'local'
# that means the same mounted volume - on OpenShift, one ReadWriteMany PVC
# mounted into both pods.
STORAGE_TYPE="azure"

# Used when STORAGE_TYPE=local. The OpenShift target.
LOCAL_STORAGE_PATH="/data/files"

# Used when STORAGE_TYPE=azure.
BLOB_CONNECTION_STRING=""
BLOB_CONTAINER_NAME=""

# --- Vector store -------------------------------------------------------------
# mongo. This is the only process that holds a vector-database client;
# main-service reaches the store through VectorService. See
# services/vector_store.py for what another backend has to implement.
VECTOR_STORE="mongo"
MONGO_CONNECTION_STRING=""
MONGO_DATABASE_NAME=""
VECTOR_COLLECTION_NAME="chatbot_policies"

# --- Embedding ----------------------------------------------------------------
# Defaults to the gte-multilingual-base copy baked into the image.
EMBEDDING_MODEL_PATH=""

GRPC_PORT=8001

# --- Vision model -------------------------------------------------------------
# Used by ParseFile for images and scanned pages only; every other format
# parses without it.
OLLAMA_MODEL="llama3.2-vision:11b"
OLLAMA_BASE_URL=""
OLLAMA_API_KEY=""
OLLAMA_TEMPERATURE=0.1
